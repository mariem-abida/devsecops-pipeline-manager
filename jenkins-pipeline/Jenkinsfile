def run_PostSuccess_22() {
                if (params.SEND_NOTIFICATIONS) {
                    echo """
╔══════════════════════════════════════════════╗
  ✅  NOTIFICATION — PIPELINE SUCCESS
      Project     : ${env.SONAR_PROJECT_KEY}
      Build       : #${env.BUILD_NUMBER}
      Commit      : ${env.GIT_COMMIT_SHORT ?: 'unknown'}
      Language    : ${env.DETECTED_LANGUAGE}
      Environment : ${env.SELECTED_ENV}
      Image       : ${env.DEPLOYED_IMAGE ?: env.REGISTRY_BUILD_TAG ?: env.DOCKER_IMAGE}
      Deployment  : ${env.DEPLOY_STATUS ?: 'SKIPPED'}
      URL         : ${env.BUILD_URL}
╚══════════════════════════════════════════════╝"""
                } else {
                    echo "✅ Pipeline SUCCESS — ${env.SONAR_PROJECT_KEY} → ${env.SELECTED_ENV}"
                }
            
}

def run_PostUnstable_23() {
                if (params.SEND_NOTIFICATIONS) {
                    echo """
╔══════════════════════════════════════════════╗
  ⚠️   NOTIFICATION — PIPELINE UNSTABLE
      Project : ${env.SONAR_PROJECT_KEY}
      Build   : #${env.BUILD_NUMBER}
      Check JUnit test results for failures.
      URL     : ${env.BUILD_URL}
╚══════════════════════════════════════════════╝"""
                } else {
                    echo '⚠️  Pipeline UNSTABLE — check JUnit results.'
                }
            
}

def run_PostFailure_24() {
                def blockSummary = blockReasons.isEmpty() ? 'See logs' : blockReasons.join(' | ')
                if (params.SEND_NOTIFICATIONS) {
                    echo """
╔══════════════════════════════════════════════╗
  ❌  NOTIFICATION — PIPELINE FAILED
      Project     : ${env.SONAR_PROJECT_KEY}
      Build       : #${env.BUILD_NUMBER}
      Commit      : ${env.GIT_COMMIT_SHORT ?: 'unknown'}
      Environment : ${env.SELECTED_ENV}
      Decision    : ${deployAllowed ? 'ALLOWED' : 'BLOCKED'}
      Reasons     : ${blockSummary}
      URL         : ${env.BUILD_URL}
╚══════════════════════════════════════════════╝"""
                } else {
                    echo "❌ Pipeline FAILED — ${env.SONAR_PROJECT_KEY} → ${blockSummary}"
                }
            
}


pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()                               // Horodatage exact dans chaque log
        timeout(time: 45, unit: 'MINUTES')         // Tue le pipeline si > 45 min
        buildDiscarder(logRotator(
            numToKeepStr:         '30',            // Conserver les 30 derniers builds
            artifactNumToKeepStr: '15'             // Conserver les artifacts des 15 derniers
        ))
    }

    parameters {
        string(
            name: 'GIT_URL',
            defaultValue: 'https://gitlab.com/devsecops-pipeline-manager/sample-python-app.git',
            description: 'GitLab repository URL'
        )
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Git branch to analyze'
        )
        choice(
            name: 'LANGUAGE',
            choices: ['auto', 'python', 'javascript', 'java'],
            description: 'Project language (auto = detect from files)'
        )
        booleanParam(name: 'RUN_TESTS',    defaultValue: true,  description: 'Run automated tests')
        booleanParam(name: 'RUN_QUALITY',  defaultValue: true,  description: 'Run code quality analysis')
        booleanParam(name: 'RUN_SECURITY', defaultValue: true,  description: 'Run security scans')
        booleanParam(name: 'RUN_SONAR',    defaultValue: true,  description: 'Run SonarQube analysis')
        booleanParam(name: 'RUN_SAST',     defaultValue: true,  description: 'Run SAST analysis (Semgrep)')
        booleanParam(name: 'RUN_DEPENDENCY', defaultValue: true, description: 'Run Dependency Scan (pip-audit/npm audit/OWASP)')
        booleanParam(name: 'RUN_SECRET',       defaultValue: true,  description: 'Run Secret Scan (Gitleaks)')
        booleanParam(name: 'RUN_DOCKER_BUILD',    defaultValue: true,  description: 'Build Docker image (requires Dockerfile in repo)')
        booleanParam(name: 'RUN_CONTAINER_SCAN',  defaultValue: true,  description: 'Scan Docker image with Trivy (CRITICAL/HIGH)')
        booleanParam(name: 'RUN_SBOM',             defaultValue: true,  description: 'Generate SBOM in CycloneDX JSON format')
        booleanParam(name: 'RUN_AI',               defaultValue: true,  description: 'Generate AI security recommendations using Gemini')
        booleanParam(name: 'PUSH_IMAGE',            defaultValue: true,  description: 'Push validated image to GitLab Container Registry')
        booleanParam(name: 'SIGN_IMAGE',            defaultValue: true,  description: 'Sign + verify immutable registry digest with Cosign')
        booleanParam(name: 'REQUIRE_PROD_APPROVAL', defaultValue: true,  description: 'Require manual approval for production-simulation')
        booleanParam(name: 'SEND_NOTIFICATIONS',    defaultValue: true,  description: 'Echo pipeline result notifications in Jenkins logs')
        choice(
            name: 'DEPLOY_ENV',
            choices: ['test', 'staging', 'production-simulation'],
            description: 'Deployment environment'
        )
    }

    environment {
        // Variables will be set dynamically via env.VARIABLE = value in script blocks.
        // DO NOT define them here if they need to be mutated across stages.
        PIPELINE_MARKER = 'DevSecOps'
    }

    stages {

        // ════════════════════════════════════════════════════════
        // 1. VALIDATE PARAMETERS
        // ════════════════════════════════════════════════════════
        stage('Validate Parameters') {
            steps {
                script {
                    run_Validate_Parameters_1()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 2. CHECKOUT
        // ════════════════════════════════════════════════════════
        stage('Checkout') {
            steps {
                script {
                    run_Checkout_2()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 3. DETECT LANGUAGE ⭐
        // Auto-detects from known files or uses manual selection
        // ════════════════════════════════════════════════════════
        stage('Detect Language') {
            steps {
                script {
                    run_Detect_Language_3()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 4. BUILD ⭐
        // Install dependencies + compile (language-specific)
        // ════════════════════════════════════════════════════════
        stage('Build') {
            steps {
                script {
                    run_Build_4()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 5. RUN TESTS
        // Strategy: grep JUnit XML (immune to exit code issues)
        // ════════════════════════════════════════════════════════
        stage('Run Tests') {
            when { expression { return params.RUN_TESTS } }
            steps {
                script {
                    run_Run_Tests_5()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 6. CODE QUALITY
        // flake8 / ESLint / Checkstyle — language-specific
        // ════════════════════════════════════════════════════════
        stage('Code Quality') {
            when { expression { return params.RUN_QUALITY } }
            steps {
                script {
                    run_Code_Quality_6()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 7. SONARQUBE ANALYSIS
        // Project key derived dynamically from GIT_URL
        // ════════════════════════════════════════════════════════
        stage('SonarQube Analysis') {
            when { expression { return params.RUN_SONAR } }
            steps {
                script {
                    run_SonarQube_Analysis_7()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 7B. SONARQUBE QUALITY GATE
        // Waits asynchronously for the SonarQube webhook result.
        // Records the gate result; later Deployment Decision blocks publish/deploy if not OK.
        // ════════════════════════════════════════════════════════
        stage('SonarQube Quality Gate') {
            when { expression { return params.RUN_SONAR } }
            steps {
                script {
                    run_SonarQube_Quality_Gate_7b()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 8. SAST — SEMGREP ⭐
        // Static Application Security Testing — language-agnostic
        // ════════════════════════════════════════════════════════
        stage('SAST') {
            when { expression { return params.RUN_SECURITY && params.RUN_SAST } }
            steps {
                script {
                    run_SAST_8()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 10. DEPENDENCY SCAN ⭐
        // pip-audit / npm audit / OWASP — language-specific
        // Gate : Python=any vuln, JS=high+, Java=CVSS≥7
        // ════════════════════════════════════════════════════════
        stage('Dependency Scan') {
            when { expression { return params.RUN_SECURITY && params.RUN_DEPENDENCY } }
            steps {
                script {
                    run_Dependency_Scan_9()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 11. SECRET SCAN ⭐ — Gitleaks
        // Detects secrets committed to Git history
        // Uses : gitleaks git (not deprecated detect)
        // Gate : any secret found = FAILED
        // ════════════════════════════════════════════════════════
        stage('Secret Scan') {
            when { expression { return params.RUN_SECURITY && params.RUN_SECRET } }
            steps {
                script {
                    run_Secret_Scan_10()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 12. DOCKER BUILD ⭐
        // Builds a versioned Docker image from the checked-out repo
        // Tag  : <project>:<BUILD_NUMBER>
        // Gate : build failure blocks deployment
        // ════════════════════════════════════════════════════════
        stage('Docker Build') {
            when { expression { return params.RUN_DOCKER_BUILD } }
            steps {
                script {
                    run_Docker_Build_11()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 13. CONTAINER SCAN ⭐ — Trivy via Docker-in-Docker
        // Scans the built image for OS + library vulnerabilities
        // Gate : CRITICAL > 0  OR  HIGH >= 5
        // Skip : automatically skipped if Docker Build failed
        // ════════════════════════════════════════════════════════
        stage('Container Scan') {
            when {
                expression {
                    return params.RUN_SECURITY &&
                           params.RUN_CONTAINER_SCAN &&
                           env.DOCKER_BUILD_STATUS == 'PASSED'
                }
            }
            steps {
                script {
                    run_Container_Scan_12()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 14. GENERATE SBOM ⭐ — CycloneDX via Trivy
        // Generates a full Software Bill of Materials from the Docker image
        // Format : CycloneDX JSON (reports/sbom.cdx.json)
        // Gate   : generation failure blocks deployment (traceability required)
        // Skip   : automatically skipped if Docker Build failed
        // ════════════════════════════════════════════════════════
        stage('Generate SBOM') {
            when {
                expression {
                    return params.RUN_SBOM &&
                           env.DOCKER_BUILD_STATUS == 'PASSED'
                }
            }
            steps {
                script {
                    run_Generate_SBOM_13()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 14B. AI SECURITY ADVISOR 🤖
        // Gemini analyzes SAST, dependency, container and SBOM reports.
        // Advisory only: AI failure never overrides deterministic security gates.
        // ════════════════════════════════════════════════════════
        stage('AI Security Advisor') {
            when {
                expression {
                    return params.RUN_AI
                }
            }
            steps {
                script {
                    run_AI_Security_Advisor_29()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 15. PREPARE POLICY INPUT ⭐
        // Writes reports/security-policy-input.json from all scan
        // env vars — becomes the OPA input document.
        // ════════════════════════════════════════════════════════
        stage('Prepare Policy Input') {
            steps {
                script {
                    run_Prepare_Policy_Input_14()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 16. TEST SECURITY POLICIES ⭐
        // Runs OPA unit tests — catches broken Rego rules BEFORE
        // they affect the deployment decision.
        // ════════════════════════════════════════════════════════
        stage('Test Security Policies') {
            steps {
                script {
                    run_Test_Security_Policies_15()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 17. POLICY AS CODE ⭐ — OPA / Rego
        // Evaluates security-policy-input.json against
        // policy/devsecops.rego and populates blockReasons.
        // deployAllowed is set by OPA, not by Groovy logic.
        // ════════════════════════════════════════════════════════
        stage('Policy as Code') {
            steps {
                script {
                    run_Policy_as_Code_16()
                }
            }
        }


        // ════════════════════════════════════════════════════════
        // 10. DEPLOYMENT DECISION
        // ════════════════════════════════════════════════════════
        stage('Deployment Decision') {
            steps {
                script {
                    run_Deployment_Decision_17()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 16. PUBLISH IMAGE ⭐
        // Pushes validated image to GitLab Container Registry
        // ONLY runs when deployAllowed == true (all gates green)
        // Tags : build-<N>  +  commit-<sha>
        // ════════════════════════════════════════════════════════
        stage('Publish Image') {
            when {
                expression {
                    return params.PUSH_IMAGE &&
                           deployAllowed == true &&
                           env.DOCKER_BUILD_STATUS == 'PASSED'
                }
            }
            steps {
                script {
                    run_Publish_Image_18()
                }
            }
        }


        stage('Resolve Image Digest') {
            when {
                expression {
                    return params.PUSH_IMAGE &&
                           deployAllowed == true &&
                           env.REGISTRY_PUSH_STATUS == 'PASSED'
                }
            }
            steps {
                script { run_Resolve_Image_Digest_25() }
            }
        }

        stage('Sign Image') {
            when {
                expression {
                    return params.SIGN_IMAGE &&
                           params.PUSH_IMAGE &&
                           deployAllowed == true &&
                           env.REGISTRY_DIGEST_STATUS == 'PASSED'
                }
            }
            steps {
                script { run_Sign_Image_26() }
            }
        }

        stage('Verify Signature') {
            when {
                expression {
                    return params.SIGN_IMAGE &&
                           env.COSIGN_SIGN_STATUS == 'PASSED'
                }
            }
            steps {
                script { run_Verify_Signature_27() }
            }
        }

        stage('Production Approval') {
            when {
                expression {
                    return deployAllowed == true &&
                           params.REQUIRE_PROD_APPROVAL &&
                           env.SELECTED_ENV == 'production-simulation'
                }
            }
            steps {
                script { run_Production_Approval_28() }
            }
        }

            // ════════════════════════════════════════════════════════
        // 24. DEPLOY — Docker Compose IaC ⭐
        // Infrastructure as Code: deployment driven by
        // deployment/docker-compose.yml + .env.runtime
        // Health check + automatic rollback on failure
        // ════════════════════════════════════════════════════════
        stage('Deploy') {
            when {
                expression { return deployAllowed == true && env.DOCKER_BUILD_STATUS == 'PASSED' }
            }
            steps {
                script {
                    run_Deploy_19()
                }
            }
        } // end Deploy


        // ════════════════════════════════════════════════════════
        // 19. GENERATE AUDIT TRAIL ⭐
        // Runs ALWAYS — full traceability record per pipeline run
        // answers: who, what, when, why blocked, what image, where deployed
        // ════════════════════════════════════════════════════════
        stage('Generate Audit Trail') {
            steps {
                script {
                    run_Generate_Audit_Trail_20()
                }
            }
        }

        // ════════════════════════════════════════════════════════
        // 20. GENERATE PIPELINE SUMMARY ⭐
        // Runs ALWAYS — even on failure — to produce the JSON artifact
        // sent to FastAPI → PostgreSQL for the Dashboard / History
        // ════════════════════════════════════════════════════════
        stage('Generate Pipeline Summary') {
            steps {
                script {
                    run_Generate_Pipeline_Summary_21()
                }
            }
        }

    } // end stages

    // ════════════════════════════════════════════════════════════
    // POST — always archive reports, even on failure
    // ════════════════════════════════════════════════════════════
    post {
        always {
            script {
                if (!fileExists('reports/audit-trail.json')) {
                    try {
                        run_Generate_Audit_Trail_20()
                    } catch (Exception e) {
                        echo "⚠️ Fallback audit trail generation failed: ${e.message}"
                    }
                }
                if (!fileExists('reports/pipeline-summary.json')) {
                    try {
                        run_Generate_Pipeline_Summary_21()
                    } catch (Exception e) {
                        echo "⚠️ Fallback pipeline summary generation failed: ${e.message}"
                    }
                }
                sh '''
                    rm -f deployment/.env.runtime 2>/dev/null || true
                    docker logout registry.gitlab.com >/dev/null 2>&1 || true
                '''
            }

            echo 'Archiving reports...'
            archiveArtifacts artifacts: 'reports/*,reports/**', allowEmptyArchive: true
            junit testResults: 'reports/test-results.xml', allowEmptyResults: true
        }
        success {
            script {
                run_PostSuccess_22()
            }
        }
        unstable {
            script {
                run_PostUnstable_23()
            }
        }
        failure {
            script {
                run_PostFailure_24()
            }
        }
    }
}
