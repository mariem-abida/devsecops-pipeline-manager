# =============================================================================
# DevSecOps Pipeline Manager — Global Environment Configuration Template
# =============================================================================
# Copy this file to .env or relevant subproject folders (.env in backend-platform,
# .env.local in frontend-platform, .env.runtime in deployment).
#
# IMPORTANT: NEVER commit real tokens, keys, passwords or secrets to Git.

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=devsecops_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=devsecops_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://devsecops_user:your_postgres_password_here@127.0.0.1:5433/devsecops_db

# -----------------------------------------------------------------------------
# 2. FastAPI Backend Platform
# -----------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# 3. Next.js Frontend Platform
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 4. Jenkins Platform
# -----------------------------------------------------------------------------
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token_here
JENKINS_JOB_NAME=devsecops-pipeline
JENKINS_TIMEOUT=15

# -----------------------------------------------------------------------------
# 5. GitLab Integration & Registry
# -----------------------------------------------------------------------------
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_access_token_here
GITLAB_REGISTRY_USER=your_gitlab_registry_username_here
GITLAB_REGISTRY_TOKEN=your_gitlab_registry_token_here

# -----------------------------------------------------------------------------
# 6. Google Gemini AI Security Advisor
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 7. SonarQube Code Quality & Security
# -----------------------------------------------------------------------------
SONARQUBE_URL=http://localhost:9001
SONAR_TOKEN=your_sonarqube_token_here

# -----------------------------------------------------------------------------
# 8. Cosign Container Image Signing
# -----------------------------------------------------------------------------
COSIGN_PASSWORD=your_cosign_key_password_here

# -----------------------------------------------------------------------------
# 9. Application Deployment Runtime (Generated per build in Jenkins)
# -----------------------------------------------------------------------------
IMAGE_NAME=registry.gitlab.com/devsecops-pipeline-manager/sample-python-app:build-1
CONTAINER_NAME=devsecops-sample-python-app-test
HOST_PORT=5001
CONTAINER_PORT=5000
APP_ENV=test
PROJECT_NAME=sample-python-app
BUILD_NUMBER=1
