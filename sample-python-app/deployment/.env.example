# DevSecOps Pipeline — Deployment Environment Example
# Copy this file to .env.runtime (generated automatically by Jenkins)
# NEVER commit .env.runtime — it contains runtime values from each build.

# Image to deploy (from GitLab Container Registry)
IMAGE_NAME=registry.gitlab.com/devsecops-pipeline-manager/sample-python-app:build-1

# Container name (must be unique per environment)
CONTAINER_NAME=devsecops-sample-python-app-test

# Port mapping: HOST_PORT → CONTAINER_PORT
# test                  → 5001
# staging               → 5002
# production-simulation → 5003
HOST_PORT=5001

# Container port per language:
# python     → 5000
# javascript → 3000
# java       → 8080
CONTAINER_PORT=5000

# Deployment context
APP_ENV=test
PROJECT_NAME=sample-python-app
BUILD_NUMBER=1
